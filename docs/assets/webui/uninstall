#!/bin/bash

# Refer to Node.js install script
#
# Run as root or insert `sudo -E` before `bash`:
#
# sudo -E bash docs/assets/webui/uninstall
#

exec_cmd_nobail() {
    echo "+ $1"
    bash -c "$1"
}

uninstall() {
exec_cmd_nobail "deb-systemd-invoke stop xcn-webui"
exec_cmd_nobail "systemctl disable xcn-webui"
exec_cmd_nobail "rm -f /lib/systemd/system/xcn-webui.service"
exec_cmd_nobail "rm -rf /usr/lib/node_modules/xcn"

exec_cmd_nobail "systemctl daemon-reload"
}

## Defer setup until we have the complete script
uninstall
