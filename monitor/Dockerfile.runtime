# Build context: a staged Meson installation containing these three artifacts.
# BASE_RUNTIME must be the currently approved full runtime, preserving its other NFs.
ARG BASE_RUNTIME
FROM ${BASE_RUNTIME}
COPY usr/bin/open5gs-amfd usr/bin/open5gs-smfd /usr/bin/
COPY usr/lib/x86_64-linux-gnu/libogsproto.so.2.7.7 /usr/lib/x86_64-linux-gnu/
RUN ldconfig
