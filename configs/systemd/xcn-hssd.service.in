[Unit]
Description=xcn HSS Daemon
Wants=mongodb.service mongod.service

[Service]
Type=simple

User=xcn
Group=xcn

Restart=always
ExecStart=@bindir@/xcn-hssd -c @sysconfdir@/xcn/hss.yaml
RestartSec=2
RestartPreventExitStatus=1
ExecReload=/bin/kill -HUP $MAINPID

[Install]
WantedBy=multi-user.target
