[Unit]
Description=xcn BSF Daemon
Wants=mongodb.service mongod.service

[Service]
Type=simple

User=xcn
Group=xcn

Restart=always
ExecStart=@bindir@/xcn-bsfd -c @sysconfdir@/xcn/bsf.yaml
RestartSec=2
RestartPreventExitStatus=1
ExecReload=/bin/kill -HUP $MAINPID

[Install]
WantedBy=multi-user.target
