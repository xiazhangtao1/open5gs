[Unit]
Description=xcn SCP Daemon
Wants=mongodb.service mongod.service

[Service]
Type=simple

User=xcn
Group=xcn

Restart=always
ExecStart=@bindir@/xcn-scpd -c @sysconfdir@/xcn/scp.yaml
RestartSec=2
RestartPreventExitStatus=1
ExecReload=/bin/kill -HUP $MAINPID

[Install]
WantedBy=multi-user.target
